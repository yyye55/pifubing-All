# 复制为 .env 后按需修改；不要提交真实密钥。

# 服务端口（Go 后端默认访问 8001）
PORT=8001

# 图片分类模型权重，默认使用仓库内的 B3_Transformer.pth
MODEL_CHECKPOINT=./B3_Transformer.pth
IMAGE_SIZE=300
CPU_THREADS=2

# 文本向量模型目录（需自行准备，例如本地 sentence-transformers 模型目录）
EMBEDDING_MODEL_PATH=
# FAISS 索引目录，索引不存在时会根据 Excel 自动重建
FAISS_INDEX_FOLDER=./faiss_index
# 皮肤病知识库 Excel（需自行准备）
DATA_FILE_PATH=

# 大模型配置
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
# 医生回答的生成参数：温度越低越稳定，0.3/0.9 是正式风格的保守默认值。
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# ===== AI 长期记忆（mem0）=====
# false：完全关闭记忆，问诊行为回到接入前
MEMORY_ENABLED=true
# 本地 qdrant 数据目录和变更历史库，均已加入 .gitignore
MEMORY_QDRANT_PATH=./memory_data/qdrant
MEMORY_HISTORY_DB=./memory_data/history.db
MEMORY_COLLECTION=skin_user_memory
# 智谱 OpenAI 兼容 embedding 模型；换模型时必须同步改维度并清空旧 qdrant 目录
MEMORY_EMBEDDING_MODEL=embedding-3
MEMORY_EMBEDDING_DIMS=2048
MEMORY_TOP_K=5
MEMORY_THRESHOLD=0.3
# Go 后端调用 /memory/* 时必须带上的内部令牌；公网部署时不要留空
MEMORY_API_TOKEN=
# 关闭 mem0 匿名遥测
MEM0_TELEMETRY=false
