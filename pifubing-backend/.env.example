# 复制为 .env 后按需修改；真实密钥不要提交到仓库。
# 本地最简启动：DB_DRIVER=sqlite + USE_MEMORY_REDIS=true，无需安装 MySQL/Redis。

# ===== 服务 =====
PORT=9094
JWT_SECRET=please-change-to-a-long-random-string

# ===== 数据库 =====
# sqlite：本地文件数据库，适合开发/演示
# mysql：使用下面的 MySQL 配置
DB_DRIVER=sqlite
SQLITE_PATH=./skin_disease.db
# 首次启动自动建表（生产环境建议关闭）
AUTO_MIGRATE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skin_disease
DB_CHARSET=utf8mb4

# ===== Redis =====
# true：进程内 miniredis，无需安装 Redis（重启后验证码/会话清空）
USE_MEMORY_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 文件存储 =====
# local：保存到后端 ./uploads 并通过 /uploads 访问
# oss：上传到阿里云 OSS
STORAGE_MODE=local
PUBLIC_BASE_URL=http://localhost:9094

OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# ===== 邮件验证码（QQ SMTP）=====
EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
EMAIL_SUBJECT=慧语星河-AI皮肤病医疗顾问
# true：不真正发邮件，验证码只打印到控制台（仅本地调试）
SKIP_EMAIL_SEND=false

# ===== AI 服务（FastAPI）=====
AI_IMAGE_API_URL=http://127.0.0.1:8001/analyze
AI_TEXT_API_URL=http://127.0.0.1:8001/process_text
# AI 长期记忆接口；留空时自动从 AI_TEXT_API_URL 推导为 http://.../memory
MEMORY_API_URL=http://127.0.0.1:8001/memory
# 必须和 Python 端 MEMORY_API_TOKEN 一致；两端都留空则不做校验（仅本地开发）
MEMORY_API_TOKEN=
# 每次最多注入几条长期记忆
MEMORY_SEARCH_LIMIT=5
# 调用大模型使用的密钥（留空则文字问诊接口返回错误）
API_KEY=
DeepSeek_R1_STUDIO_API_KEY=
DeepSeek_V3_STUDIO_API_KEY=
# 医生回答的生成参数：温度越低越稳定，0.3/0.9 是正式风格的保守默认值。
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9

# ===== 图片问诊：最终回答模型直接看图 =====
# false：关闭视觉链路，图片问诊回到原来的纯文本回答
VISION_ANSWER_ENABLED=true
# 多模态模型：glm-4v-plus 效果更好；账号不支持时改成 glm-4v-flash
VISION_ANSWER_MODEL=glm-4v-plus
# 留空时依次复用 LLM_API_KEY / DeepSeek_R1_STUDIO_API_KEY
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OSS 签名 URL 有效期（秒）
VISION_IMAGE_URL_TTL=600
# 每次最多传给模型几张图
VISION_MAX_IMAGES=3
# auto：本机 ./uploads 有文件就优先 base64，否则用 URL
# url：始终让模型自己下载；base64：优先读本地文件
VISION_IMAGE_SOURCE=auto
# 额外允许的图片域名，逗号分隔，支持 *.example.com；一般不用填
VISION_IMAGE_HOSTS=

# ===== 短信 / 微信登录（可选）=====
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
