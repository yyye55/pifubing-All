# ===== 环境变量与密钥 =====
# 真实的 .env 只保留在本地，绝不能提交到 GitHub
.env
.env.*
!.env.example
!*.env.example
# 前端开发环境地址不含密钥，可以提交
!pifubing-frontend/.env.development

# ===== Go 后端 =====
pifubing-backend/.idea/
pifubing-backend/*.iml
pifubing-backend/*.db
pifubing-backend/*.sqlite
pifubing-backend/*.sqlite3
pifubing-backend/*.log
pifubing-backend/temp/
pifubing-backend/avatar_temp/
# 本地存储模式下用户上传的图片
pifubing-backend/uploads/
pifubing-backend/temp_images/
pifubing-backend/temp_files/
# 旧版本编译产物和联调临时文件，不进入仓库
pifubing-backend/SkinDisease
pifubing-backend/SkinDisease.exe
pifubing-backend/*.exe
pifubing-backend/tempcehsi*.png
pifubing-backend/uploaded_urls.txt

# ===== 前端 =====
pifubing-frontend/node_modules/
pifubing-frontend/dist/
pifubing-frontend/dist-ssr/
pifubing-frontend/*.local
pifubing-frontend/vite.config.js.timestamp-*
pifubing-frontend/.vite/

# ===== Python =====
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
pifubing-pythonCode/temp_files/
pifubing-pythonCode/temp_images/
pifubing-pythonCode/*.log
# 本地生成的 FAISS 向量索引（可由 Excel 自动重建，不入库）
pifubing-pythonCode/faiss_index/
# AI 长期记忆的本地 qdrant 向量库和变更历史，含用户病史，绝不能入库
pifubing-pythonCode/memory_data/
# 本地模拟数据，仅用于调试检索链路
pifubing-pythonCode/mock_data/
# 训练产物（best/last 权重、日志），只在本地保留
pifubing-pythonCode/training/runs/
# 本地校验脚本与备份文件
pifubing-pythonCode/check_kb.py
pifubing-pythonCode/check_model.py
pifubing-pythonCode/*.bak

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志与临时文件 =====
*.log
*.tmp

# Whisper 语音识别模型（体积大，首次使用时自动下载）
pifubing-pythonCode/models/
