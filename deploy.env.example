# 复制为 .env 后再执行 docker compose up -d --build
# 该文件供 docker-compose.yml 读取，不是后端/前端自身的 .env。

# 必填：JWT 签名密钥（请使用随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
# 公网访问地址，用于拼接上传图片的 URL
PUBLIC_BASE_URL=https://your-domain.com

# 邮件验证码
EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
EMAIL_SUBJECT=慧语星河-AI皮肤病医疗顾问
SKIP_EMAIL_SEND=false

# Go 后端调用大模型生成回答时使用
API_KEY=
DeepSeek_R1_STUDIO_API_KEY=
DeepSeek_V3_STUDIO_API_KEY=

# Python AI 服务（智谱 GLM-4-Flash，与 Go 后端的硬编码地址保持一致）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
# 知识库资源目录（挂载到容器 /app/data）
AI_DATA_DIR=./ai-data
# 容器内路径，需位于 /app/data 下
EMBEDDING_MODEL_PATH=/app/data/model
DATA_FILE_PATH=/app/data/knowledge.xlsx

# 图片存储：local 保存到容器 ./uploads；oss 上传阿里云 OSS
STORAGE_MODE=local

# 可选：阿里云 OSS（STORAGE_MODE=oss 时使用）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# 图片问诊：最终回答模型直接看图（需要多模态模型）
VISION_ANSWER_ENABLED=true
VISION_ANSWER_MODEL=glm-4v-plus
# 留空时依次复用 LLM_API_KEY / DeepSeek_R1_STUDIO_API_KEY
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OSS 签名 URL 有效期（秒），只够模型拉图即可
VISION_IMAGE_URL_TTL=600
# 每次最多传给模型几张图
VISION_MAX_IMAGES=3
# auto：本机 ./uploads 有文件就优先 base64，否则用 URL
# url：始终让模型自己下载；base64：优先读本地文件
VISION_IMAGE_SOURCE=auto
# 额外允许的图片域名，逗号分隔，支持 *.example.com；一般不用填
VISION_IMAGE_HOSTS=
