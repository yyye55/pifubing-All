# 复制为 .env 后再执行 docker compose up -d --build
# 该文件供 docker-compose.yml 读取，不是后端/前端自身的 .env。

# 必填：JWT 签名密钥（请使用随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
# 公网访问地址，用于拼接上传图片的 URL
PUBLIC_BASE_URL=https://your-domain.com

# 邮件验证码
EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
EMAIL_SUBJECT=慧语星河-AI皮肤病医疗顾问
SKIP_EMAIL_SEND=false

# Go 后端调用大模型生成回答时使用
API_KEY=
DeepSeek_R1_STUDIO_API_KEY=
DeepSeek_V3_STUDIO_API_KEY=

# Python AI 服务
LLM_API_KEY=
LLM_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
LLM_MODEL=deepseek-r1
# 知识库资源目录（挂载到容器 /app/data）
AI_DATA_DIR=./ai-data
# 容器内路径，需位于 /app/data 下
EMBEDDING_MODEL_PATH=/app/data/model
DATA_FILE_PATH=/app/data/knowledge.xlsx

# 可选：阿里云 OSS（STORAGE_MODE=oss 时使用）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
